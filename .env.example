# AI model to use (e.g. gpt-4o, gemini-2.0-flash, claude-3-5-sonnet-20241022)
AI_MODEL=gpt-4o-mini

# Set the API key for the provider matching AI_MODEL (at least one required for analysis)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Cache: backend type ("file" or "diskcache"), optional TTL in seconds, file path for file backend
CACHE_BACKEND=file
CACHE_TTL_SECONDS=
CACHE_FILE_PATH=image_cache.json

# Image preprocessing: max dimension (resize), JPEG quality (1-100)
MAX_IMAGE_DIMENSION=2048
JPEG_QUALITY=85
